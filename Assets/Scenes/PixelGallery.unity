    pose: {fileID: 21300000, guid: 6fc59f8ecfc03e34ead0937ab09f2c23, type: 3}
    restPose: {fileID: 21300000, guid: 451ab1c20bb87854f8ab7b2be65484a1, type: 3}
    text: The invaders are slippery, so they'll dodge up and down. Keep your eyes
      peeled and your aim steady!
    altText: Heads up, these little guys actually dodge. Unlike the ducks. The ducks
      just kinda... accepted it.
    portrait: {fileID: 0}
  - speaker: CURLY
    pose: {fileID: 21300000, guid: 6fc59f8ecfc03e34ead0937ab09f2c23, type: 3}
    restPose: {fileID: 21300000, guid: 451ab1c20bb87854f8ab7b2be65484a1, type: 3}
    text: Squids, blobs, saucers, the whole fleet's here. The rarer the alien, the
      bigger the points!
    altText: Squids, blobs, saucers. The weirder it looks, the more it's worth. Like
      most things in life.
    portrait: {fileID: 0}
  - speaker: CURLY
    pose: {fileID: 21300000, guid: 6fc59f8ecfc03e34ead0937ab09f2c23, type: 3}
    restPose: {fileID: 21300000, guid: a901f5f1194f7d84a80cd658918d0a24, type: 3}
    text: And if you spot a red saucer... shoot it. Trust me.
    altText: And if you see a red saucer, shoot it. I'm not explaining. You'll know.
    portrait: {fileID: 0}
  outroLines:
  - speaker: CURLY
    pose: {fileID: 21300000, guid: a2e24a93ae860ff41a3adcb572ed78e2, type: 3}
    restPose: {fileID: 0}
    text: Whoa! The invaders have retreated! Earth is safe, and so is the boardwalk!
    altText: Huh. Earth survived. Honestly, did not have that on my bingo card.
    portrait: {fileID: 0}
  - speaker: CURLY
    pose: {fileID: 21300000, guid: 6fc59f8ecfc03e34ead0937ab09f2c23, type: 3}
    restPose: {fileID: 21300000, guid: 451ab1c20bb87854f8ab7b2be65484a1, type: 3}
    text: You're a real space hero, friend. The whole galaxy owes you one!
    altText: Congrats, you saved the planet. No, there's no medal. Budget cuts.
    portrait: {fileID: 0}
  - speaker: CURLY
    pose: {fileID: 21300000, guid: 21a0693a0f910f7499bb422dd1e125af, type: 3}
    restPose: {fileID: 0}
    text: Thanks for playing! Let's go see how you scored!
    altText: Great job, space cadet. Let's go see how good or bad that went.
    portrait: {fileID: 0}
  duckAfterOutro: 1
  showRunningTotal: 1
  endMessage: TIME!
  clearTargetsAtEnd: 0
  nextSceneName: ScoreTally
  onRoundEnd:
    m_PersistentCalls:
      m_Calls: []
  countdownSounds:
