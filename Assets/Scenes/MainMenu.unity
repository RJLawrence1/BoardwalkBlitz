      m_Calls: []
  m_text: "<color=#FF3020>AIM:</color> Move the mouse or stick to aim your cork gun.\n\n\n<color=#FF3020>SHOOT:</color>
    Click, Right Trigger, or A to fire. Every hit spins the target and scores points!\n\n\n<color=#FF3020>COMBO:</color>
    Hit in a row to raise your multiplier, up to x4. Miss, and it resets!\n\n\n<color=#FF3020>RELOAD:</color>
    After 99 shots, you'll reload for a second. Make 'em count.\n\n\n<color=#FF3020>SPECIALS:</color>
    Rare targets are worth way more. Keep an eye out...\n\n\n<color=#FF3020>PAUSE:</color>
    Press Esc or Start.\n\n\n<i><color=#AAAAAA>\"Step right up and show 'em what
    you've got!\" \n- Curly</color></i>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f5abfaf5af8282e4cbee004210f3b1c3, type: 2}
