  m_Script: {fileID: 11500000, guid: fe2ca590539248d47a5f8235ad08afbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ResultsScreen
  scoreText: {fileID: 1175772234}
  scoreGhost: {fileID: 664407384}
  scoreGhostChar: 56
  scoreDigits: 7
  rankText: {fileID: 500385301}
  rankGhost: {fileID: 1333779701}
  rankGhostChar: 126
  curlyText: {fileID: 1935084045}
  ranks:
  - title: NO SHOW
    minScore: 0
    curlyLine: ...Did you forget to pull the trigger? That's okay, friend. Everyone
      had a lovely evening anyway.
    altLine: Zero. Zero points. I've seen the ticket booth guy score higher, and
      he was asleep.
  - title: ROOKIE
    minScore: 1
    curlyLine: A valiant effort! And by valiant, I mean... you showed up. That counts!
    altLine: Well! You definitely held a cork gun. I'll give you that much.
  - title: MIDWAY REGULAR
    minScore: 15000
    curlyLine: Hey, not bad! You've got the makings of a real boardwalk regular.
    altLine: Not bad. Not good either. Very... middle of the midway.
  - title: SHARPSHOOTER
    minScore: 30000
    curlyLine: Not bad at all! Everyone here is mildly impressed, and that's hard
      to do.
    altLine: Okay, okay, you can actually aim. I'm almost impressed. Almost.
  - title: DEADEYE
    minScore: 45000
    curlyLine: Spectacular! Phenomenal! I'd tip my hat, but it's stuck.
    altLine: Damn, alright! I'd tip my hat, but honestly I don't get paid enough
      to fight with it.
  - title: CARNIVAL ACE
    minScore: 60000
    curlyLine: Everyone, keep an eye on this one! The prize booth is getting nervous.
    altLine: Somebody lock up the giant teddy bears, this one's coming for all of
      'em.
  - title: BOARDWALK LEGEND
    minScore: 80000
    curlyLine: ...Wait, seriously? Ladies and gentlemen, we have a CHAMPION!
    altLine: ...Are you cheating? No? Then what the hell. Ladies and gentlemen, a
      LEGEND!
  countUpTime: 2
  rankSound: {fileID: 0}
  firstBoothScene: DucksGallery
  mainMenuScene: MainMenu
